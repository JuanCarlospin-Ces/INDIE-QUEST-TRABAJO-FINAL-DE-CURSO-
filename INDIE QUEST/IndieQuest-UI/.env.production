# Production environment for Vercel deployment
# 
# IMPORTANT: The API is running locally on your machine.
# You MUST expose it using localtunnel before deploying to Vercel:
# 
# 1. Open a terminal in the root project directory
# 2. Run: npm run tunnel:api
#    (This creates a public tunnel to your local API)
# 3. Copy the URL from the output (e.g., https://indiequest-api-xxxx.loca.lt)
# 4. Replace the URL below with your tunnel URL
# 5. Rebuild and redeploy to Vercel
# 
# The tunnel URL persists as long as the command is running on your machine

VITE_API_BASE_URL=https://indiequest-api.loca.lt/api
